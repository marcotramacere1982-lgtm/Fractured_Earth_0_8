  "light": {
    "darkSight": 1,
    "note": "Decision 74: in the dark a marker sees only lit squares (an on light covers squares within its radius that it can see) and the squares within darkSight of itself. Bright environment: lights don't matter, except where Darkness zones are laid."
  },
  "darkness": {
    "attack": {
      "thermal": -2,
      "unseen": -4
    },
    "stealth": {
      "unlit": 2,
      "lit": -4
    },
    "perception": {
      "dark": -2
    },
    "note": "Decision 76: TN modifiers the sheet suggests in the dark (the player confirms). Attack: a target seen only as a heat signature -2 (no called shots), one in the dark you cannot see -4. Stealth: +2 in an unlit square, -4 when lit or carrying a lit torch. Perception: -2 in the dark, cancelled by night vision or thermal."
  },
